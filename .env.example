# Bothost supplies the connected bot token and DOMAIN automatically.
# No variables need to be added manually on Bothost.
# Optional overrides for another hosting environment (this file is not auto-loaded):
# BOT_TOKEN=<token of your Telegram bot>
# WEBAPP_URL=https://your-domain.example
# TELEGRAM_WEBHOOK_SECRET=<optional custom secret; otherwise derived automatically>
# DATABASE_PATH=data/pickaxe.sqlite3
# PORT=3000
# REGISTER_WEBHOOK=0  # Only to disable automatic registration.
